{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|ApplyPatch|Edit|Write|MultiEdit|NotebookEdit|create_file|edit_file|write_file|str_replace_editor|replace_string_in_file|insert_edit_into_file|multi_replace_string_in_file",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'for d in \"$PLUGIN_ROOT\" \"$CLAUDE_PLUGIN_ROOT\" .; do [ -n \"$d\" ] && [ -f \"$d/agent/run_critic.sh\" ] && exec bash \"$d/agent/run_critic.sh\"; done; printf \"{}\\n\"'",
            "timeout": 15,
            "statusMessage": "CacheLayer CRITIC"
          }
        ]
      }
    ]
  }
}
