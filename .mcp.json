{
  "mcpServers": {
    "cachelayer": {
      "url": "https://api.cachelayer.org/mcp/http",
      "bearer_token_env_var": "CACHELAYER_KEY"
    },
    "cachelayer-agent": {
      "type": "stdio",
      "command": "./cachelayer_tools/run_mcp.sh",
      "cwd": ".",
      "env_vars": [
        "CACHELAYER_WORKSPACE_ROOT"
      ]
    }
  }
}
